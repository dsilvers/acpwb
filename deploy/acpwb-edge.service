[Unit]
Description=ACPWB edge (TLS termination + JA4/HTTP2 fingerprinting; replaces nginx)
After=network-online.target redis-server.service acpwb-gunicorn.service acpwb-go.service
Wants=network-online.target

[Service]
Type=simple
User=acpwb
Group=acpwb
# www-data: the gunicorn socket is acpwb:www-data 0770 under a 0750 dir.
SupplementaryGroups=www-data
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=200000
WorkingDirectory=/home/acpwb/acpwb/acpwb_edge

Environment=EDGE_HTTPS_ADDR=:443
Environment=EDGE_HTTP_ADDR=:80
Environment=EDGE_CERT_DIR=/etc/acpwb-edge/certs
Environment=EDGE_DJANGO_UPSTREAM=unix:/run/acpwb-gunicorn/gunicorn.sock
Environment=EDGE_GO_UPSTREAM=127.0.0.1:8091
Environment=EDGE_WS_UPSTREAM=127.0.0.1:8765
Environment=EDGE_BOTSEED_WS_UPSTREAM=127.0.0.1:8766
Environment=EDGE_BOTSEED_API_UPSTREAM=127.0.0.1:8767
Environment=EDGE_STATIC_ROOT=/home/acpwb/acpwb/acpwb/staticfiles
Environment=EDGE_BOTSEED_ROOT=/home/acpwb/acpwb/botseed
Environment=EDGE_ACME_ROOT=/var/www/certbot
Environment=REDIS_URL=redis://127.0.0.1:6379/0
# Secrets live outside the repo: /etc/acpwb-edge/env (root:acpwb 0640) holds
# EDGE_COOKIE_SECRET=<random>, which signs the acpwb_cid client cookie. It
# must not change, or every browser gets a new client ID. Generate once:
#   printf 'EDGE_COOKIE_SECRET=%s\n' "$(openssl rand -hex 32)" > /etc/acpwb-edge/env
EnvironmentFile=-/etc/acpwb-edge/env
# Counters (/debug/vars) + pprof — localhost only, never public.
Environment=EDGE_DEBUG_ADDR=127.0.0.1:6061
# Limits are never per client (bots get unthrottled access). These only
# protect the process: stall timeout for clients that stop reading/sending,
# a last-resort global in-flight valve, and per-IP record aggregation
# (exact counts, fewer rows) for floods of connections that carry no
# request — connections with requests are always recorded individually,
# and every request gets its own EdgeRequest row. Defaults shown.
#Environment=EDGE_STALL_TIMEOUT_SECONDS=60
#Environment=EDGE_MAX_IN_FLIGHT=100000
#Environment=EDGE_RECORDS_PER_IP_MINUTE=600

ExecStart=/home/acpwb/acpwb/acpwb_edge/acpwb_edge
# SIGHUP reloads certificates (the certbot deploy hook sends it).
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM drains connections gracefully (up to 15s).
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
