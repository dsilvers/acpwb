[Unit]
Description=ACPWB live request-stream WS service
After=network.target redis-server.service

[Service]
Type=simple
User=acpwb
Group=acpwb
WorkingDirectory=/home/acpwb/acpwb/ws_service
EnvironmentFile=/home/acpwb/acpwb/.env
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Environment=WS_PORT=8765
ExecStart=/home/acpwb/acpwb/ws_service/venv/bin/python ws_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
