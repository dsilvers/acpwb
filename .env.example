# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
# Leading dot matches acpwb.com plus every subdomain (archives-YYYY, policy-*, www)
DJANGO_ALLOWED_HOSTS=.acpwb.com,localhost,127.0.0.1

# Database
DB_NAME=acpwb
DB_USER=acpwb
DB_PASSWORD=acpwb_dev
DB_HOST=db
DB_PORT=5432

# Cloudflare Email Worker inbound pipe
PIPE_WEBHOOK_SECRET=generate-a-long-random-secret

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

STREAM_WS_TOKEN="bananana"
