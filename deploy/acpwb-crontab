# ACPWB production cron jobs — install with: crontab -u acpwb deploy/acpwb-crontab
#
# cron does not load .env, so each job sources it manually before invoking manage.py
*/30 * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py precalc_dashboard' >> /var/log/acpwb-precalc.log 2>&1
* * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py drain_crawler_queue' >> /var/log/acpwb-crawler-drain.log 2>&1
* * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py drain_archive_queue' >> /var/log/acpwb-archive-drain.log 2>&1

# Residential-proxy-detection pipeline (see the plan this implements).
# score_ip_reputation and publish_ip_reputation start conservative (every
# 5/15 min) — tighten once RequestFingerprint has real production volume
# and the scoring output has been checked against it.
* * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py drain_fingerprint_queue' >> /var/log/acpwb-fingerprint-drain.log 2>&1
*/5 * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py score_ip_reputation' >> /var/log/acpwb-score-ip-reputation.log 2>&1
*/15 * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py publish_ip_reputation' >> /var/log/acpwb-publish-ip-reputation.log 2>&1

# IPIntelligence: discover new IPs from CrawlerVisit (1-hour windows, 50s
# budget per run, resumes from its watermark), then MaxMind-enrich them
# (local mmdb lookups only). Both flock-guarded, so overlapping runs just
# exit. Neither was ever installed before 2026-09-30 — the table sat frozen
# at Sep 4 with 15M IPs unenriched, which is also what score_ip_reputation's
# is_hosting signal reads.
#
# Commented out until the manual catch-up (discover from Sep 4, then the ~15M
# enrichment backlog) has finished and its per-window timing has been checked.
# */5 * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py discover_ip_intelligence' >> /var/log/acpwb-ip-intel-discover.log 2>&1
# */15 * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py enrich_ip_intelligence --max-seconds 600' >> /var/log/acpwb-ip-intel-enrich.log 2>&1

# DISABLED 2026-09-06 — do not install this job as-is. acpwb_go writes
# CrawlerVisit rows with bot_type/bot_group blank (it doesn't classify at
# write time), and this cron was meant to backfill them incrementally. In
# its first-ever production run it never completed a single 1000-row
# batch in 8+ minutes: Django's bulk_update() issues one UPDATE with a
# CASE WHEN per scattered primary-key id, and on this table (a 373M+ row
# TimescaleDB hypertable) that forces expensive cross-chunk work, unlike
# the time-range-filtered queries TimescaleDB handles well. The blank-row
# backlog grew (23k -> 71k) faster than the job could shrink it, so it
# would never converge. Both stuck runs were killed manually (SIGTERM to
# the manage.py process does not cancel the in-flight query — had to
# pg_cancel_backend() the Postgres side directly).
#
# The lock-sharing fix with precalc_dashboard (flock on
# /tmp/precalc_dashboard.lock) is still correct and still needed if this
# job is reinstated in some form, but the underlying approach — classify
# via cron backfill rather than at write time — needs to be redesigned
# before this runs in production again. See CLAUDE.md / deploy/README.md
# for status.
#
# * * * * * cd /home/acpwb/acpwb && bash -c 'set -a; source .env; set +a; exec /home/acpwb/acpwb/.direnv/python-3.14/bin/python /home/acpwb/acpwb/acpwb/manage.py backfill_bot_types' >> /var/log/acpwb-bot-backfill.log 2>&1
