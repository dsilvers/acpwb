[Unit]
Description=ACPWB botseed WS/HTTP service
After=network.target redis-server.service

[Service]
Type=simple
User=acpwb
Group=acpwb
WorkingDirectory=/home/acpwb/acpwb/botseed_service
EnvironmentFile=/home/acpwb/acpwb/.env
Environment=WS_PORT=8766
Environment=API_PORT=8767
ExecStart=/home/acpwb/acpwb/.direnv/python-3.14/bin/python ws_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
